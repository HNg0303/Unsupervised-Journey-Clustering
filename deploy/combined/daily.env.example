# Settings of the combined journey-service (deploy/combined). Copy to daily.env (git-ignored).

# --- Kafka ---
# Giả lập (docker-compose.sim.yml): kafka:9092, không mật khẩu.
# Kafka công ty: danh sách broker cách nhau bởi dấu phẩy + username/password Kafka (SASL PLAIN,
# như code Go dùng plain.Mechanism). Có username thì service tự dùng SASL_PLAINTEXT + PLAIN;
# để trống username/password thì chạy không SASL. Không ghi mật khẩu thật vào file nào khác.
#   staging:    KAFKA_BOOTSTRAP_SERVERS=<broker-staging-1>:<port>,<broker-staging-2>:<port>,...
#               KAFKA_TOPIC=hifpt-events_ingress-2
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=hifpt-event-simulation
KAFKA_SASL_PLAIN_USERNAME=
KAFKA_SASL_PLAIN_PASSWORD=
# Chỉ cần khi khác mặc định: SASL_SSL (broker có TLS, thêm KAFKA_SSL_CAFILE) hoặc SCRAM-SHA-256/512
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
# Topics of each /pipeline/runs (comma separated); empty = KAFKA_TOPIC. A request can pass its own.
PIPELINE_TOPICS=
# Bản gộp: mỗi run lấy data xong thì chạy luôn model
PIPELINE_RUN_MODEL=true
# Required by the app. The day export joins no group; the group is only used by the
# optional background consumer (CONSUMER_AUTOSTART=true). Never the prod group
# hifpt-insight-ingress-consumer-group (the app refuses it).
KAFKA_GROUP_ID=journey-clustering-event-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
CUSTOMER_ID_TOKEN_CLAIMS=customer_id
OUTPUT_TIMEZONE=Asia/Ho_Chi_Minh
# Background consumer writing data/events/date=<day>/events.csv all the time: off,
# the pipeline reads Kafka by date when a request comes
CONSUMER_AUTOSTART=false
OUTPUT_DIR=./data/events
# Set to require the X-API-Key header (Airflow sends it as JOURNEY_SERVICE_API_KEY)
# API_KEY=

# --- Model job (scripts/daily_journey_job.py), paths inside Unsupervised-Journey-Clustering ---
MODEL_RUN=output/partitioned_runs/678/678_20260929_090904
NAMES_RUN=output/scores/678/678_20260929_090904
PLATFORMS=android ios
OUTPUT_ROOT=output/daily

# --- MariaDB journey_summary (off until the DB team creates the table) ---
# MariaDB on this machine: MARIADB_HOST=host.docker.internal
LOAD_MARIADB=0
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=
MARIADB_TABLE=journey_summary
