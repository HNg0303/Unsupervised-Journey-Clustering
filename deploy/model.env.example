# Settings of the journey-model service (deploy/docker-compose.yml). Copy to model.env (git-ignored).
# Event của ngày đọc từ thư mục storage của service Kafka (EVENTS_PATH trong docker-compose.yml),
# service này không nối Kafka.

# --- Model (đường dẫn trong repo, output/ được mount) ---
MODEL_RUN=output/partitioned_runs/678/678_20260929_090904
NAMES_RUN=output/scores/678/678_20260929_090904
PLATFORMS=android ios
OUTPUT_TIMEZONE=Asia/Ho_Chi_Minh
OUTPUT_ROOT=output/daily

# --- MariaDB journey_summary (off until the DB team creates the table) ---
# MariaDB on this machine: MARIADB_HOST=host.docker.internal
LOAD_MARIADB=0
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=
MARIADB_TABLE=journey_summary
