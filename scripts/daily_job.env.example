# Settings of scripts/daily_journey_job.py. Copy to scripts/daily_job.env and pass
#   python scripts/daily_journey_job.py --config scripts/daily_job.env
# Relative paths are from the repo root (CONSUMER_ENV_FILE: from CONSUMER_DIR).

# --- 1. Events from Kafka (event-consumer-fastapi) ---
CONSUMER_DIR=../event-consumer-fastapi
# Python with the consumer requirements; empty = <CONSUMER_DIR>/.venv/bin/python, else this Python
CONSUMER_PYTHON=
# Kafka settings for the export; empty = <CONSUMER_DIR>/.env
CONSUMER_ENV_FILE=simulation/sim.env
# export = read the day from Kafka by timestamp (no group, no commit)
# folder = use date=YYYY-MM-DD/events.csv written by the background consumer
EVENTS_SOURCE=export
EVENTS_DIR=
OUTPUT_TIMEZONE=Asia/Ho_Chi_Minh

# --- 2/3. Model (inference only, no retraining) ---
MODEL_RUN=output/partitioned_runs/678/678_20260929_090904
NAMES_RUN=output/scores/678/678_20260929_090904
MODEL_VERSION=
SITEMAP=taxonomy/hifpt_sitemap_taxonomy.csv
PLATFORMS=android ios
OUTPUT_ROOT=output/daily

# --- 4. MariaDB journey_summary (off until the DB team creates the table) ---
LOAD_MARIADB=0
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=
MARIADB_TABLE=journey_summary
MARIADB_BATCH_SIZE=5000
